{
  "name": "revio",
  "productName": "Revio",
  "version": "0.2.3",
  "description": "A focused desktop app for code reviews, with Claude briefings and scoped review guidelines.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Douglas Pires",
  "homepage": "https://github.com/douglas-pires/revio",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:adhoc": "electron-vite build && electron-builder --mac -c.mac.identity=-",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@octokit/rest": "^22.0.1",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "io.github.douglas-pires.revio",
    "productName": "Revio",
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "douglas-pires",
        "repo": "revio",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/douglas-pires/revio.git"
  },
  "packageManager": "pnpm@12.8.1"
}
